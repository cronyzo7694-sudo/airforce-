 {
  "id": "q_sscchsl_reasoning_009",
  "subject": "reasoning",
  "subjectName": "General Intelligence & Reasoning",
  "chapter": "Calendar",
  "topic": "Day Calculation",
  "difficulty": "hard",
  "questionText": "If 1 January 2024 was a Monday, what day was 26 January 2024?",
  "questionTextHi": "यदि 1 जनवरी 2024 को सोमवार था, तो 26 जनवरी 2024 को कौन-सा दिन था?",
  "image": null,
  "options": [
   {
    "id": "A",
    "text": "Friday"
   },
   {
    "id": "B",
    "text": "Saturday"
   },
   {
    "id": "C",
    "text": "Thursday"
   },
   {
    "id": "D",
    "text": "Sunday"
   }
  ],
  "correctAnswer": "A",
  "explanation": "26 Jan = day 26. (26−1) mod 7 = 25 mod 7 = 4 → Monday + 4 = Friday.",
  "explanationHi": "26 जन = दिन 26। (26−1) mod 7 = 4 → सोमवार + 4 = शुक्रवार।",
  "source": "SSC CHSL Tier-I PYQ-style demo · Kineora",
  "year": "2023",
  "tags": [
   "ssc-chsl",
   "demo-temp"
  ],
  "figureBased": false,
  "paper": "Tier-I"
 },
