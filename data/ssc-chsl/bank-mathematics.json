  "id": "q_sscchsl_mathematics_001",
  "subject": "mathematics",
  "subjectName": "Quantitative Aptitude",
  "chapter": "Number System",
  "topic": "Simplification",
  "difficulty": "easy",
  "questionText": "If 45% of a number is 90, what is 60% of that number?",
  "questionTextHi": "यदि किसी संख्या का 45% , 90 है, तो उस संख्या का 60% क्या होगा?",
  "image": null,
  "options": [
   {
    "id": "A",
    "text": "120"
   },
   {
    "id": "B",
    "text": "110"
   },
   {
    "id": "C",
    "text": "100"
   },
   {
    "id": "D",
    "text": "130"
   }
  ],
  "correctAnswer": "A",
  "explanation": "Number = 90 × 100/45 = 200. 60% of 200 = 120.",
  "explanationHi": "संख्या = 90 × 100/45 = 200। 200 का 60% = 120।",
  "source": "SSC CHSL Tier-I PYQ-style demo · Kineora",
  "year": "2023",
  "tags": [
   "ssc-chsl",
   "Number System"
  ],
  "figureBased": false,
  "paper": "Tier-I"
