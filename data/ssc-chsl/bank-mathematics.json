 {
  "id": "q_sscchsl_mathematics_001",
  "subject": "mathematics",
  "subjectName": "Quantitative Aptitude",
  "chapter": "Number System",
  "topic": "Simplification",
  "difficulty": "easy",
  "questionText": "If 45% of a number is 90, what is 60% of that number?",
  "questionTextHi": "यदि किसी संख्या का 45% , 90 है, तो उस संख्या का 60% क्या होगा?",
  "image": null,
  "options": [
   {
    "id": "A",
    "text": "120"
   },
   {
    "id": "B",
    "text": "110"
   },
   {
    "id": "C",
    "text": "100"
   },
   {
    "id": "D",
    "text": "130"
   }
  ],
  "correctAnswer": "A",
  "explanation": "Number = 90 × 100/45 = 200. 60% of 200 = 120.",
  "explanationHi": "संख्या = 90 × 100/45 = 200। 200 का 60% = 120।",
  "source": "SSC CHSL Tier-I PYQ-style demo · Kineora",
  "year": "2023",
  "tags": [
   "ssc-chsl",
   "demo-temp"
  ],
  "figureBased": false,
  "paper": "Tier-I"
 },
 {
  "id": "q_sscchsl_mathematics_002",
  "subject": "mathematics",
  "subjectName": "Quantitative Aptitude",
  "chapter": "Ratio & Proportion",
  "topic": "Sharing",
  "difficulty": "easy",
  "questionText": "Rs 1,200 is divided among A, B and C in the ratio 2 : 3 : 5. What is B's share?",
  "questionTextHi": "Rs 1,200 को A, B और C में 2 : 3 : 5 के अनुपात में बाँटा गया। B का हिस्सा कितना है?",
  "image": null,
  "options": [
   {
    "id": "A",
    "text": "Rs 240"
   },
   {
    "id": "B",
    "text": "Rs 360"
   },
   {
    "id": "C",
    "text": "Rs 400"
   },
   {
    "id": "D",
    "text": "Rs 600"
   }
  ],
  "correctAnswer": "B",
  "explanation": "Total parts = 2+3+5 = 10. One part = 1200/10 = Rs 120. B = 3 × 120 = Rs 360.",
  "explanationHi": "कुल भाग = 2+3+5 = 10। एक भाग = 1200/10 = Rs 120। B = 3 × 120 = Rs 360।",
  "source": "SSC CHSL Tier-I PYQ-style demo · Kineora",
  "year": "2023",
